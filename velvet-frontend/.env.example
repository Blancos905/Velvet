# Base URL API (vuoto = path relativi `/api` → proxy Vite in dev)
# VITE_API_BASE_URL=https://api.example.com
# Se la base termina già con `/api`, non raddoppiare: i path nel codice sono `/api/v1/...` (apiUrl evita `/api/api/v1/...`).

# Solo dev (vite.config.ts): dove inoltrare `/api` se non usi VITE_API_BASE_URL. Default: http://127.0.0.1:8080
# VITE_PROXY_API_TARGET=http://127.0.0.1:8082

# Partner saloni: default senza variabili = pagina interna /partner (sempre raggiungibile).
# Per aprire un sito esterno: VITE_PARTNER_SIGNUP_URL=https://…
# VITE_PARTNER_SIGNUP_URL=
# Email pulsante «Scrivici» sulla pagina partner (opzionale)
# VITE_PARTNER_CONTACT_EMAIL=commerciale@example.com

# Opzionale: iframe Google Maps (Embed API) in dashboard titolare — senza chiave si usa embed legacy output=embed
# VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Link store per il footer «Scarica l'app» (solo sito web)
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=it.saloniluxury.velvet_app
# VITE_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX

# Opzionale: PIN per sbloccare la pagina Statistiche (account titolare). Se assente, i dati si caricano senza PIN.
# VITE_SALON_STATISTICS_PIN=

# Documenti legali pubblici (store / GDPR) — valorizzare in produzione
# VITE_COMPANY_NAME=Saloni Luxury
# VITE_COMPANY_LEGAL_NAME=Ragione sociale completa S.r.l.
# VITE_COMPANY_ADDRESS=Via Example 1, 00100 Roma (RM), Italia
# VITE_COMPANY_VAT=IT00000000000
# VITE_COMPANY_EMAIL=privacy@saloniluxury.it
# VITE_LOG_RETENTION_DAYS=180

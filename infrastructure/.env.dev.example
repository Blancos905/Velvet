# Copia opzionale: cp .env.dev.example .env.dev
# Avvio: docker compose --env-file .env.dev -f docker-compose.dev.yml up --build
# Se ometti il file, docker-compose.dev.yml usa i default di sviluppo qui sotto.

# Postgres del Mac (l'API nel container usa host.docker.internal).
LUXURY_DEV_DB_HOST=host.docker.internal
LUXURY_DEV_DB_PORT_INTERNAL=5432
# Solo profilo embedded-db: Postgres vuoto pubblicato sull'host.
LUXURY_DEV_DB_PORT=5433
LUXURY_DEV_DB_NAME=c1luxury
LUXURY_DEV_DB_USER=postgres
LUXURY_DEV_DB_PASSWORD=postgres

# Redis pubblicato sull'host.
LUXURY_DEV_REDIS_PORT=6380
LUXURY_DEV_REDIS_PASSWORD=luxury-dev-redis

# Sito (nginx + SPA) e API Spring diretta.
LUXURY_DEV_HTTP_PORT=8080
LUXURY_DEV_API_PORT=8082

# Segreto JWT solo per questo stack locale. Non riusarlo in produzione.
LUXURY_DEV_JWT_SECRET=luxury-dev-token-secret-change-in-production-32b

# SMTP non sta qui. L'API Docker lo legge da luxury/spring-dev.local.env
# a ogni avvio dello stack.

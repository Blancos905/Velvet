# Copia in ".env" e valorizza con segreti reali. NON committare il .env reale.

# --- PostgreSQL ---
DB_NAME=salonplatform
DB_USER=salon
DB_PASSWORD=cambia-questa-password-robusta

# --- Redis ---
REDIS_PASSWORD=cambia-questa-password-redis

# --- JWT (chiave HMAC a 256 bit in Base64) ---
# Genera con: openssl rand -base64 48
JWT_SECRET=GENERA_UNA_CHIAVE_BASE64_DI_ALMENO_32_BYTE

# --- CORS (origini frontend autorizzate, separate da virgola) ---
CORS_ORIGINS=https://www.saloniluxury.it,https://saloniluxury.it

# --- SEO: base URL pubblica usata in canonical, sitemap e JSON-LD ---
SITE_BASE_URL=https://www.saloniluxury.it

# --- Stripe billing (modalità test: nessuna P.IVA richiesta finché resti su sk_test_) ---
# Dashboard Stripe → Developers → API keys + Products/Prices + Webhooks
LUXURY_BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PREMIUM_PRICE_ID=price_REPLACE_ME
# Locale: stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe

# --- Email transazionali (conferma prenotazione, promemoria) — SMTP casella noreply@ ---
# Login pannello Aruba (hosting/domini): username 19867967@aruba.it — NON la Gmail di contatto.
# Webmail caselle: privacy@ / assistenza@ / noreply@saloniluxury.it (password per casella).
# SMTP sotto: solo noreply@saloniluxury.it + password della casella noreply.
LUXURY_MAIL_ENABLED=true
LUXURY_MAIL_FROM=noreply@saloniluxury.it
LUXURY_MAIL_FROM_DISPLAY_NAME=Saloni Luxury
# Aruba SSL: smtps.aruba.it:465 (587 STARTTLS spesso bloccata da rete locale/Docker)
SPRING_MAIL_HOST=smtps.aruba.it
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=noreply@saloniluxury.it
SPRING_MAIL_PASSWORD=INSERISCI_PASSWORD_CASella_NOREPLY
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=false
SPRING_MAIL_SMTP_SSL=true

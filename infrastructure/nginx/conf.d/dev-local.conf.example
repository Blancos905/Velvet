# =============================================================================
# Nginx — SVILUPPO LOCALE (esempio, NON usare in produzione)
#
# In dev l'app Flutter carica Vite (:5173) e le API passano dal proxy Vite → Spring (:8080).
# NON serve nginx in locale: evita CSP/HSTS che bloccano http://127.0.0.1 o IP LAN.
#
# Se devi testare la SPA buildata (dist/) servita da nginx in locale:
#   1) Commenta redirect HTTPS e usa solo listen 8081;
#   2) Rilassa CSP connect-src: 'self' http://127.0.0.1:8080 http://192.168.*.*:* ;
#   3) NON usare add_header HSTS in dev.
#
# Esempio minimo (salva come conf.d/dev-local.conf.example):
#
# server {
#     listen 8081;
#     server_name localhost;
#     root /path/to/luxury-frontend/dist;
#     location / {
#         try_files $uri $uri/ /index.html;
#     }
#     location /api/ {
#         proxy_pass http://127.0.0.1:8080;
#         proxy_http_version 1.1;
#         proxy_set_header Connection "";
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_read_timeout 30s;
#     }
# }
#
# Produzione: usa app.conf con TLS; CORS è gestito da Spring (luxury.cors.allowed-origins).
# =============================================================================

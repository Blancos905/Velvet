# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
ENV['COCOAPODS_PARALLEL_CODE_SIGN'] = 'false'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  strip_phase_name = 'Strip xattrs before CodeSign'
  strip_script = <<~'SCRIPT'
    strip_xattrs() {
      if [ -e "$1" ]; then
        xattr -cr "$1" 2>/dev/null || true
      fi
    }
    strip_xattrs "${TARGET_BUILD_DIR}/${WRAPPER_NAME}"
    strip_xattrs "${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.framework"
    strip_xattrs "${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.bundle"
    strip_xattrs "${BUILT_PRODUCTS_DIR}/${FULL_PRODUCT_NAME}"
  SCRIPT

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    next if target.shell_script_build_phases.any? { |phase| phase.name == strip_phase_name }

    phase = target.new_shell_script_build_phase(strip_phase_name)
    phase.shell_script = strip_script
  end

  # iCloud Desktop: rsync into Runner.app re-applies xattr; strip before embed codesign.
  frameworks_script = File.join(installer.sandbox.root, 'Target Support Files/Pods-Runner/Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_script)
    contents = File.read(frameworks_script)
    marker = 'xattr -cr "${destination}/$(basename "$1")"'
    unless contents.include?(marker)
      contents = contents.sub(
        '  code_sign_if_enabled "${destination}/$(basename "$1")"',
        "  #{marker} 2>/dev/null || true\n  code_sign_if_enabled \"${destination}/$(basename \"$1\")\""
      )
      File.write(frameworks_script, contents)
    end
  end
end

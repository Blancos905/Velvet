# Copia: cd luxury && cp spring-dev.local.env.example spring-dev.local.env
# Il file spring-dev.local.env è in .gitignore (non va su Git).

SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL locale (attivo) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/c1luxury?currentSchema=c1luxury
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- MariaDB remota via tunnel SSH / phpMyAdmin (disattivato; chiedi all'agente per ripristinarla) ---
# Tunnel SSH (terminale separato, lascialo aperto):
#   ssh -N -L 3307:127.0.0.1:3306 vboxuser@192.168.1.80
# SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:3307/c1luxury
# SPRING_DATASOURCE_USERNAME=c1luxury_app
# SPRING_DATASOURCE_PASSWORD=

# Schema già allineato al codice: avvio veloce senza ALTER all'avvio (niente attese lunghe sul tunnel).
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Opzionale: anagrafica consumer super admin (nome in assistenza, telefono).
# LUXURY_SUPER_ADMIN_PROFILE_DISPLAY_NAME=Mario Rossi
# LUXURY_SUPER_ADMIN_PROFILE_PHONE=+39...

# --- Email transazionali (SMTP Aruba, casella noreply@) ---
# Login pannello Aruba: 19867967@aruba.it (non Gmail). SPRING_MAIL_USERNAME = noreply@saloniluxury.it.
# Abilita invio reale; indirizzi seed (es. cliente1@test.com) vengono saltati senza bloccare prenotazioni/notifiche.
LUXURY_MAIL_ENABLED=true
# LUXURY_MAIL_FROM=noreply@saloniluxury.it
# LUXURY_MAIL_FROM_DISPLAY_NAME=Saloni Luxury
# SPRING_MAIL_HOST=smtps.aruba.it
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=noreply@saloniluxury.it
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=false
# SPRING_MAIL_SMTP_SSL=true
#
# Ore dopo la fine appuntamento prima dell'invito recensione (ammissibilità in-app). Default codice: 2.
# LUXURY_REVIEW_INVITE_OFFSET_HOURS=2

# --- Log retention (informativa privacy; allineare a VITE_LOG_RETENTION_DAYS) ---
# LUXURY_LOG_RETENTION_DAYS=180

# --- Stripe billing (default ON in dev locale; richiede chiavi test Stripe) ---
LUXURY_BILLING_ENABLED=true
# Giorni di prova gratuita Premium (fallback senza Stripe; allineato a Stripe Checkout). Default 30. Per test locale post-prova: 0
# LUXURY_BILLING_PROMOTIONAL_TRIAL_DAYS=0
LUXURY_FATTURAPA_ENABLED=false
# LUXURY_BILLING_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# Webhook locale: ./scripts/stripe-listen-dev.sh (terminale separato)

# URL frontend per link email e ritorno Stripe.
# Dev: ./scripts/dev-backend.sh rileva l'IP LAN (Vite «Network: http://192.168.x.x:5173») e sovrascrive questo valore.
# Registrazione da app: il backend usa l'Origin della WebView (prioritario su questo valore).
# Avvio manuale mvnw: aggiorna l'IP qui se testi solo da browser senza app.
# LUXURY_NOTIFICATIONS_FRONTEND_BASE_URL_AUTO=0  # disabilita auto-IP in dev-backend.sh
# LUXURY_NOTIFICATIONS_FRONTEND_BASE_URL=http://192.168.1.55:5173

# --- Fattura elettronica FatturaPA (XML gratuito → portale AdE) ---
# Obbligatorio in produzione per emettere fatture legali verso i saloni Premium.
# LUXURY_FATTURAPA_ENABLED=true
# LUXURY_BILLING_ISSUER_LEGAL_NAME=Ragione sociale completa
# LUXURY_BILLING_ISSUER_VAT=12345678901
# LUXURY_BILLING_ISSUER_FISCAL_CODE=12345678901
# LUXURY_BILLING_ISSUER_ADDRESS=Via Example 1
# LUXURY_BILLING_ISSUER_POSTAL_CODE=00100
# LUXURY_BILLING_ISSUER_CITY=Roma
# LUXURY_BILLING_ISSUER_PROVINCE=RM
# LUXURY_BILLING_ISSUER_TAX_REGIME=RF19
# LUXURY_BILLING_ISSUER_VAT_NATURE=N2.2
# LUXURY_BILLING_ISSUER_ADMIN_EMAIL=tua-email@example.com

# Copiare su server: sudo cp luxury.env.example /etc/luxury/luxury.env
# sudo chmod 600 /etc/luxury/luxury.env   (solo root)
# Completare SPRING_DATASOURCE_PASSWORD e i segreti JWT (vedi application-prod.properties).
#
# Sviluppo locale con MariaDB (phpMyAdmin): profilo Spring `local` — vedi
# luxury/src/main/resources/application-local.properties.example

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082

# Nome esatto: SPRING_DATASOURCE_URL (non SOURCE_URL / JDBC_URL casuali). Una riga vuota SPRING_DATASOURCE_URL= rompe il default.
SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:3306/c1luxury
SPRING_DATASOURCE_USERNAME=c1luxury_app
SPRING_DATASOURCE_PASSWORD=

# Se il jar non include ancora application-prod aggiornato (Hibernate 7), decommentare:
# SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MariaDBDialect
# SPRING_JPA_PROPERTIES_HIBERNATE_BOOT_ALLOW_JDBC_METADATA_ACCESS=false

# (non è letto dal backend attuale; JWT login = HS256 firmato da Luxury con la riga sotto).

# Token HMAC: prenotazioni/recensioni (link «Gestisci»/«Recensione») + firma JWT da POST /api/v1/auth/login (se non imposti auth-jwt dedicato).
LUXURY_TOKEN_SECRET=

# JWT Bearer per /api/v1/me/** (emesso da POST /api/v1/auth/login). Opzionale: segreto dedicato (default = LUXURY_TOKEN_SECRET).
LUXURY_AUTH_JWT_SECRET=
# Access token breve (minuti) + refresh (giorni) — requisito sicurezza store/production.
LUXURY_AUTH_ACCESS_TTL_MINUTES=15
LUXURY_REFRESH_TOKEN_TTL_DAYS=30
LUXURY_AUTH_JWT_TTL_HOURS=24

# Opzionale in lab: se serve Swagger/OpenAPI con profilo prod (default in application-prod: disattivati).
# SPRINGDOC_API_DOCS_ENABLED=true
# SPRINGDOC_SWAGGER_UI_ENABLED=true

# --- Notifiche transazionali ---
# Conferma prenotazione e promemoria: inbox in-app + push FCM + email SMTP (se abilitata sotto).
# Recupero password: link generato e SOLO loggato sul backend (email reset da integrare separatamente).
# LUXURY_PUBLIC_FRONTEND_URL=https://www.saloniluxury.it
# LUXURY_REVIEW_INVITE_OFFSET_HOURS=24

# --- SMTP (Aruba: smtps.aruba.it:465 SSL — preferito; alternativa smtp.aruba.it:587 STARTTLS) ---
# Login pannello Aruba: 19867967@aruba.it (non la Gmail di contatto). SMTP: solo noreply@saloniluxury.it.
# LUXURY_MAIL_ENABLED=true
# LUXURY_MAIL_FROM=noreply@saloniluxury.it
# LUXURY_MAIL_FROM_DISPLAY_NAME=Saloni Luxury
# SPRING_MAIL_HOST=smtps.aruba.it
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=noreply@saloniluxury.it
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=false
# SPRING_MAIL_SMTP_SSL=true

# --- Log retention (informativa privacy) ---
# LUXURY_LOG_RETENTION_DAYS=180

# SPA su host diverso dall'API: imposta origini (virgole); mappa su luxury.cors.allowed-origins
# LUXURY_CORS_ALLOWED_ORIGINS=https://www.example.com

# Super admin (pannello /api/v1/admin): username obbligatorio; password in chiaro da env OPPURE hash BCrypt (preferito in prod).
# LUXURY_SUPER_ADMIN_USERNAME=
# LUXURY_SUPER_ADMIN_PASSWORD=
# LUXURY_SUPER_ADMIN_PASSWORD_HASH=
# Token lungo per la sola prima registrazione UI (POST /api/v1/admin/auth/register): senza username/password/hash super admin in env.
# LUXURY_SUPER_ADMIN_SETUP_TOKEN=
# Opzionale: nome e telefono sul profilo consumer del super admin (assistenza / PATCH da pannello).
# LUXURY_SUPER_ADMIN_PROFILE_DISPLAY_NAME=Mario Rossi
# LUXURY_SUPER_ADMIN_PROFILE_PHONE=+39...

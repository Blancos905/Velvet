[Unit]
Description=Luxury Spring Boot API
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=luxury
Group=luxury
WorkingDirectory=/opt/luxury
EnvironmentFile=-/etc/luxury/luxury.env
ExecStart=/usr/bin/java -jar /opt/luxury/luxury.jar
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Velvet Spring Boot API
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=velvet
Group=velvet
WorkingDirectory=/opt/velvet
EnvironmentFile=-/etc/velvet/velvet.env
ExecStart=/usr/bin/java -jar /opt/velvet/velvet.jar
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

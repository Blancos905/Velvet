# Copiare su server: sudo cp velvet.env.example /etc/velvet/velvet.env
# sudo chmod 600 /etc/velvet/velvet.env   (solo root)
# Completare SPRING_DATASOURCE_PASSWORD e i segreti JWT (vedi application-prod.properties).
#
# Sviluppo locale con MariaDB (phpMyAdmin): profilo Spring `local` — vedi
# velvet/src/main/resources/application-local.properties.example

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082

# Nome esatto: SPRING_DATASOURCE_URL (non SOURCE_URL / JDBC_URL casuali). Una riga vuota SPRING_DATASOURCE_URL= rompe il default.
SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:3306/c1velvet
SPRING_DATASOURCE_USERNAME=c1velvet_app
SPRING_DATASOURCE_PASSWORD=

# Se il jar non include ancora application-prod aggiornato (Hibernate 7), decommentare:
# SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MariaDBDialect
# SPRING_JPA_PROPERTIES_HIBERNATE_BOOT_ALLOW_JDBC_METADATA_ACCESS=false

# Keycloak / OAuth2 resource server: non usare più — non impostare SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI
# (non è letto dal backend attuale; JWT login = HS256 firmato da Velvet con la riga sotto).

# Token HMAC: prenotazioni/recensioni (link «Gestisci»/«Recensione») + firma JWT da POST /api/v1/auth/login (se non imposti auth-jwt dedicato).
VELVET_TOKEN_SECRET=

# JWT Bearer per /api/v1/me/** (emesso da POST /api/v1/auth/login). Opzionale: segreto dedicato (default = VELVET_TOKEN_SECRET).
VELVET_AUTH_JWT_SECRET=
# Access token breve (minuti) + refresh (giorni) — requisito sicurezza store/production.
VELVET_AUTH_ACCESS_TTL_MINUTES=15
VELVET_REFRESH_TOKEN_TTL_DAYS=30
VELVET_AUTH_JWT_TTL_HOURS=24

# Opzionale in lab: se serve Swagger/OpenAPI con profilo prod (default in application-prod: disattivati).
# SPRINGDOC_API_DOCS_ENABLED=true
# SPRINGDOC_SWAGGER_UI_ENABLED=true

# --- Notifiche transazionali ---
# Le email NON vengono inviate al di fuori della piattaforma: messaggio in inbox + log backend.
# Recupero password: link generato e SOLO loggato sul backend.
# VELVET_PUBLIC_FRONTEND_URL=https://www.example.com
# VELVET_REVIEW_INVITE_OFFSET_HOURS=24

# --- WhatsApp: backend → POST JSON verso webhook (bridge incluso in deploy/whatsapp-bridge) ---
# VELVET_NOTIFICATIONS_WHATSAPP_ENABLED=true
# URL del bridge (stessa VM: http://127.0.0.1:3099/webhooks/whatsapp) o servizio esterno.
# VELVET_NOTIFICATIONS_WHATSAPP_WEBHOOK_URL=http://127.0.0.1:3099/webhooks/whatsapp
# Stesso segreto del bridge VELVET_BRIDGE_BEARER_TOKEN (opzionale ma consigliato in prod).
# VELVET_NOTIFICATIONS_WHATSAPP_BEARER_TOKEN=
# VELVET_NOTIFICATIONS_WHATSAPP_DEFAULT_COUNTRY_CALLING_CODE=39

# SPA su host diverso dall'API: imposta origini (virgole); mappa su velvet.cors.allowed-origins
# VELVET_CORS_ALLOWED_ORIGINS=https://www.example.com

# Super admin (pannello /api/v1/admin): username obbligatorio; password in chiaro da env OPPURE hash BCrypt (preferito in prod).
# VELVET_SUPER_ADMIN_USERNAME=
# VELVET_SUPER_ADMIN_PASSWORD=
# VELVET_SUPER_ADMIN_PASSWORD_HASH=
# Token lungo per la sola prima registrazione UI (POST /api/v1/admin/auth/register): senza username/password/hash super admin in env.
# VELVET_SUPER_ADMIN_SETUP_TOKEN=
# Opzionale: nome e telefono sul profilo consumer del super admin (assistenza / PATCH da pannello).
# VELVET_SUPER_ADMIN_PROFILE_DISPLAY_NAME=Mario Rossi
# VELVET_SUPER_ADMIN_PROFILE_PHONE=+39...

# Copia in .env sulla macchina del bridge (o esporta queste variabili nel systemd/docker).
# Porta HTTP del bridge (Velvet deve puntare qui con VELVET_NOTIFICATIONS_WHATSAPP_WEBHOOK_URL).
PORT=3099

# Obbligatorio se Velvet ha VELVET_NOTIFICATIONS_WHATSAPP_BEARER_TOKEN: stesso valore.
# VELVET_BRIDGE_BEARER_TOKEN=

# meta | twilio | log (solo console, per provare il flusso senza provider)
VELVET_BRIDGE_PROVIDER=log

# --- Meta WhatsApp Cloud API (provider=meta) ---
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# --- Twilio WhatsApp (provider=twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

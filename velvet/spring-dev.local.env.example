# Copia: cd velvet && cp spring-dev.local.env.example spring-dev.local.env
# Il file spring-dev.local.env è in .gitignore (non va su Git).

SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL locale (attivo) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/c1velvet?currentSchema=c1velvet
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- MariaDB remota via tunnel SSH / phpMyAdmin (disattivato; chiedi all'agente per ripristinarla) ---
# Tunnel SSH (terminale separato, lascialo aperto):
#   ssh -N -L 3307:127.0.0.1:3306 vboxuser@192.168.1.80
# SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:3307/c1velvet
# SPRING_DATASOURCE_USERNAME=c1velvet_app
# SPRING_DATASOURCE_PASSWORD=

# Schema già allineato al codice: avvio veloce senza ALTER all'avvio (niente attese lunghe sul tunnel).
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Opzionale: anagrafica consumer super admin (nome in assistenza, telefono).
# VELVET_SUPER_ADMIN_PROFILE_DISPLAY_NAME=Mario Rossi
# VELVET_SUPER_ADMIN_PROFILE_PHONE=+39...

# --- Email transazionali (SMTP Aruba, casella noreply@) ---
# Login pannello Aruba: 19867967@aruba.it (non Gmail). SPRING_MAIL_USERNAME = noreply@saloniluxury.it.
# Abilita invio reale; indirizzi seed (es. cliente1@test.com) vengono saltati senza bloccare prenotazioni/notifiche.
VELVET_MAIL_ENABLED=true
# VELVET_MAIL_FROM=noreply@saloniluxury.it
# VELVET_MAIL_FROM_DISPLAY_NAME=Saloni Luxury
# SPRING_MAIL_HOST=smtps.aruba.it
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=noreply@saloniluxury.it
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=false
# SPRING_MAIL_SMTP_SSL=true
#
# Ore dopo la fine appuntamento prima dell'invito recensione (ammissibilità in-app). Default codice: 2.
# VELVET_REVIEW_INVITE_OFFSET_HOURS=2

# --- Log retention (informativa privacy; allineare a VITE_LOG_RETENTION_DAYS) ---
# VELVET_LOG_RETENTION_DAYS=180

# --- Stripe billing (default OFF finché non hai P.IVA e incassi abbonamenti) ---
VELVET_BILLING_ENABLED=false
# Mesi di prova gratuita Premium dalla registrazione (default 6). Per test locale post-prova: 0
# VELVET_BILLING_PROMOTIONAL_TRIAL_MONTHS=0
VELVET_FATTURAPA_ENABLED=false
# VELVET_BILLING_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# Webhook locale: ./scripts/stripe-listen-dev.sh (terminale separato)

# --- Fattura elettronica FatturaPA (XML gratuito → portale AdE) ---
# Obbligatorio in produzione per emettere fatture legali verso i saloni Premium.
# VELVET_FATTURAPA_ENABLED=true
# VELVET_BILLING_ISSUER_LEGAL_NAME=Ragione sociale completa
# VELVET_BILLING_ISSUER_VAT=12345678901
# VELVET_BILLING_ISSUER_FISCAL_CODE=12345678901
# VELVET_BILLING_ISSUER_ADDRESS=Via Example 1
# VELVET_BILLING_ISSUER_POSTAL_CODE=00100
# VELVET_BILLING_ISSUER_CITY=Roma
# VELVET_BILLING_ISSUER_PROVINCE=RM
# VELVET_BILLING_ISSUER_TAX_REGIME=RF19
# VELVET_BILLING_ISSUER_VAT_NATURE=N2.2
# VELVET_BILLING_ISSUER_ADMIN_EMAIL=tua-email@example.com

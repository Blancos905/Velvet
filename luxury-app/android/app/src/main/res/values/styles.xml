<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Splash Android 12+: niente piatto bianco dietro l'icona.
      Icona = logo circolare; sfondo icona = stesso colore splash (invisibile).
    -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/luxury_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/luxury_splash_background</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/luxury_splash_background</item>
    </style>
</resources>
